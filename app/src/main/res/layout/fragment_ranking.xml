<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header roxo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#534AB7"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ranking"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSubtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Classificação geral dos cursos"
                        android:textSize="12sp"
                        android:textColor="#CECBF6"
                        android:layout_marginBottom="12dp"/>

                    <!-- Abas Geral / Por Modalidade -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#3C3489"
                        android:padding="4dp"
                        android:layout_marginHorizontal="-16dp">

                        <TextView
                            android:id="@+id/tabGeral"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Geral"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:background="@drawable/bg_tab_active"/>

                        <TextView
                            android:id="@+id/tabModalidade"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Por modalidade"
                            android:textSize="13sp"
                            android:textColor="#AFA9EC"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Chips de modalidade (visível só na aba Por Modalidade) -->
                <HorizontalScrollView
                    android:id="@+id/scrollChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layoutChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"/>
                </HorizontalScrollView>

                <!-- Pódio visual (top 3) -->
                <LinearLayout
                    android:id="@+id/layoutPodio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom|center_horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <!-- 2º lugar -->
                    <LinearLayout
                        android:id="@+id/col2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:id="@+id/tvSigla2" android:layout_width="44dp"
                            android:layout_height="44dp" android:gravity="center"
                            android:textSize="13sp" android:textStyle="bold"
                            android:textColor="#085041" android:background="@drawable/bg_avatar_teal"/>
                        <TextView android:id="@+id/tvNome2" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="9sp"
                            android:textColor="?attr/colorOnSurfaceVariant" android:gravity="center"
                            android:layout_marginTop="4dp"/>
                        <TextView android:id="@+id/tvPts2" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="11sp"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="4dp"/>
                        <LinearLayout android:id="@+id/bar2" android:layout_width="56dp"
                            android:layout_height="44dp" android:background="#9FE1CB"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="2" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="#085041"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 1º lugar -->
                    <LinearLayout
                        android:id="@+id/col1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:id="@+id/tvSigla1" android:layout_width="52dp"
                            android:layout_height="52dp" android:gravity="center"
                            android:textSize="15sp" android:textStyle="bold"
                            android:textColor="#3C3489" android:background="@drawable/bg_avatar"/>
                        <TextView android:id="@+id/tvNome1" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="9sp"
                            android:textColor="?attr/colorOnSurfaceVariant" android:gravity="center"
                            android:layout_marginTop="4dp"/>
                        <TextView android:id="@+id/tvPts1" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="11sp"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="4dp"/>
                        <LinearLayout android:id="@+id/bar1" android:layout_width="56dp"
                            android:layout_height="64dp" android:background="#534AB7"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="1" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@android:color/white"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 3º lugar -->
                    <LinearLayout
                        android:id="@+id/col3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:id="@+id/tvSigla3" android:layout_width="44dp"
                            android:layout_height="44dp" android:gravity="center"
                            android:textSize="13sp" android:textStyle="bold"
                            android:textColor="#633806" android:background="@drawable/bg_avatar_amber"/>
                        <TextView android:id="@+id/tvNome3" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="9sp"
                            android:textColor="?attr/colorOnSurfaceVariant" android:gravity="center"
                            android:layout_marginTop="4dp"/>
                        <TextView android:id="@+id/tvPts3" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="11sp"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="4dp"/>
                        <LinearLayout android:id="@+id/bar3" android:layout_width="56dp"
                            android:layout_height="32dp" android:background="#FAC775"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="3" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="#633806"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ProgressBar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"/>

                <!-- RecyclerView lista completa -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRanking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <!-- Estado vazio -->
                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="Nenhuma classificação disponível"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>